#!/bin/bash

# If not running interactively, don't do anything
case $- in
    *i*) ;;
      *) return;;
esac

# don't put duplicate lines or lines starting with space in the history.
# See bash(1) for more options
HISTCONTROL=ignoreboth

# for setting history length see HISTSIZE and HISTFILESIZE in bash(1)
HISTSIZE=5000
HISTFILESIZE=10000

# prompt
YELL="\[$(tput setaf 3)\]"
BLUE="\[$(tput setaf 4)\]"
MAGE="\[$(tput setaf 5)\]"
CYAN="\[$(tput setaf 6)\]"
WHIT="\[$(tput setaf 7)\]"
RESET="\[$(tput sgr0)\]"

aws_profile () {
    if [[ -n "$AWS_PROFILE" ]]; then
        echo "$(tput setaf 6)[AWS $AWS_PROFILE]$(tput sgr0) "
    fi
}
current_eks () {
    if [ -n "$KUBECONFIG" ]; then
        local ctx=$(kubectl config current-context 2>/dev/null || echo "no-context")

        local color=166 # strong orange
        if [[ $ctx = *prod* ]]; then
            if [[ $ctx = *use2* ]]; then
                color=161 # royal red
            else
                color=160 # guardsman red
            fi
        else
            if [[ $ctx = *use2* ]]; then
                color=34 # dark lime green
            else
                color=70 # dark green
            fi
        fi

        echo "$(tput setaf $color)[K8S $ctx]$(tput sgr0) "
    fi

}
export PS1="\n ${BLUE}\u${MAGE}@${BLUE}\h \$(aws_profile)\$(current_eks)${CYAN}\w${RESET} \n :3 "

# directory-dependent tools
PATH="${ASDF_DATA_DIR:-$HOME/.asdf}/shims:$PATH"

# completion
eval "$(fzf --bash)"

if [[ -x "$HOME/.local/bin/aws_completer" ]]; then
    complete -C "$HOME/.local/bin/aws_completer" aws
fi

# Homebrew
if type brew &>/dev/null; then
    HOMEBREW_PREFIX="$(brew --prefix)"

    if [[ -r "${HOMEBREW_PREFIX}/etc/profile.d/bash_completion.sh" ]]; then
        source "${HOMEBREW_PREFIX}/etc/profile.d/bash_completion.sh"
    else
        for COMPLETION in "${HOMEBREW_PREFIX}/etc/bash_completion.d/"*; do
            if [[ -r "${COMPLETION}" ]]; then
                source "${COMPLETION}"
            fi
        done
    fi
fi

# kubectl completion
if type kubectl &>/dev/null; then
    # include completion for k alias
    source <(
        kubectl completion bash | \
            awk '
                /^[\t ]+complete.* kubectl/ { print; gsub(/ kubectl$/, " k"); print; next };
                { print }
            '
    )
fi

if type mise &>/dev/null; then
    eval "$(mise activate bash)"
fi

function chaws () {
    if ! type aws &>/dev/null; then
        echo "No aws command found!"
        return 1
    fi

    local fzf_args=""
    if [[ -n $1 ]]; then
        fzf_args="--query $1"
    fi

    local newprofile=$(aws configure list-profiles | fzf $fzf_args)

    if [[ -n $newprofile ]]; then
        export AWS_PROFILE=$newprofile
    fi

    return 0
}

function cheks () {
    if ! type kubectl &>/dev/null; then
        echo "No kubectl command found!"
        return 1
    fi

    local merged_kubeconfig="$HOME/.local/var/gc1-eks/allk8"
    if [[ ! -f "$merged_kubeconfig" ]]; then
        echo "No merged kubeconfig found!"
        return 1
    fi

    local fzf_args=""
    if [[ -n $1 ]]; then
        fzf_args="--query $1"
    fi

    local newctx=$( \
                    kubectl \
                        --kubeconfig "$merged_kubeconfig" \
                        config \
                        get-contexts \
                        -o name \
                        | fzf $fzf_args \
          )

    if [[ -n $newctx ]]; then
        export KUBECONFIG="$merged_kubeconfig"
        kubectl config use-context "$newctx"
    else
        return 0
    fi

    local user=$(kubectl config view -o jsonpath='{.contexts[?(@.name == "'$newctx'")].context.user}')

    local profile=$(
        kubectl config view -o json | \
            jq -r '
              .["current-context"] as $ctx
              | (.contexts[] | select(.name == $ctx) | .context.user) as $user
              | .users[] | select(.name == $user)
              | .user.exec.env[] | select(.name == "AWS_PROFILE") | .value'
    )

    export AWS_PROFILE=$profile

    return 0
}

alias bw="flatpak run --command=bw com.bitwarden.desktop"
alias k='kubectl'

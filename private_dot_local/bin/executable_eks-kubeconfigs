#!/usr/bin/env -S uv run --script
# -*- mode: python; -*-
#
# /// script
# requires-python = ">=3.11"
# dependencies = [
#   "boto3==1.43.114",
# ]
# ///
"""Regenerate one kubeconfig file per EKS cluster.

Every gc1- profile in ~/.aws/config is scanned for EKS clusters, and each
cluster gets its own kubeconfig in ~/.local/var/gc1-eks, named after (and
containing a single context named after) the cluster plus a region suffix.

Shell functions (cheks/change_eks) point KUBECONFIG at one of these files, so
each terminal session has its own context.
"""

import argparse
import configparser
import fnmatch
import os
import subprocess
import sys
import tempfile
import time
from concurrent.futures import ThreadPoolExecutor, as_completed
from pathlib import Path

AWS_CONFIG = Path(os.environ.get("AWS_CONFIG_FILE", Path.home() / ".aws" / "config"))
K8S_DIR = Path.home() / ".local" / "var" / "gc1-eks"
PROFILE_PREFIX = "gc1-"
EKS_REGIONS = ["us-east-1", "us-east-2"]
MAX_WORKERS = 10


def refresh_profiles():
    stamp = AWS_CONFIG.with_name(f"{AWS_CONFIG.name}.aims-updated")
    if (
        not AWS_CONFIG.exists()
        or not stamp.exists()
        or time.time() - stamp.stat().st_mtime > 3600
    ):
        try:
            subprocess.run([str(Path(__file__).with_name("aws-profiles"))], check=True)
        except (OSError, subprocess.CalledProcessError) as error:
            sys.exit(f"ERROR: AWS profile regeneration failed: {error}")


def list_profiles(patterns: list[str]) -> list[str]:
    config = configparser.ConfigParser()
    if not config.read(AWS_CONFIG):
        sys.exit(f"Couldn't read AWS config at {AWS_CONFIG}")

    profiles = sorted(
        s.removeprefix("profile ")
        for s in config.sections()
        if s.startswith(f"profile {PROFILE_PREFIX}")
    )
    if patterns:
        profiles = [
            p for p in profiles if any(fnmatch.fnmatch(p, pat) for pat in patterns)
        ]
    return profiles


def kubeconfig_path(cluster: str, region: str, clusters: set[str] | None = None) -> Path:
    region_tokens = ("use1", "us-east-1", "use2", "us-east-2")
    if any(t in cluster.lower() for t in region_tokens):
        return K8S_DIR / cluster
    suffix = "-use2" if region == "us-east-2" else "-use1"
    # If the suffixed and unsuffixed names both exist in this region, keep the
    # unsuffixed cluster's path equal to its actual name.
    if clusters and f"{cluster}{suffix}" in clusters:
        return K8S_DIR / cluster
    return K8S_DIR / f"{cluster}{suffix}"


def write_kubeconfig(profile: str, region: str, cluster: str, dest: Path) -> str | None:
    """Generate a kubeconfig into a temp file, then atomically replace dest.

    Returns an error message on failure.
    """
    fd, tmp = tempfile.mkstemp(dir=K8S_DIR, prefix=f".{dest.name}.")
    os.close(fd)
    os.unlink(tmp)  # let the aws cli create it from scratch
    try:
        result = None
        for attempt in range(3):
            result = subprocess.run(
                [
                    "aws", "eks", "update-kubeconfig",
                    "--profile", profile,
                    "--region", region,
                    "--name", cluster,
                    "--kubeconfig", tmp,
                    "--alias", dest.name,
                ],
                capture_output=True,
                text=True,
                env={**os.environ, "AWS_CONFIG_FILE": str(AWS_CONFIG)},
            )
            if result.returncode == 0 or "Throttling" not in result.stderr:
                break
            time.sleep(2**attempt)

        if result.returncode != 0:
            return result.stderr.strip()

        os.chmod(tmp, 0o600)
        os.replace(tmp, dest)
        return None
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)


def process(profile: str, region: str) -> tuple[list[tuple[str, str, str, Path]], bool]:
    """Return cluster destinations to preflight, and whether listing succeeded."""
    import boto3

    try:
        eks = boto3.Session(profile_name=profile).client("eks", region_name=region)
        clusters = eks.list_clusters()["clusters"]
    except Exception as e:
        print(f"    WARN [{profile}/{region}]: {e}")
        return [], False

    destinations = []
    cluster_names = set(clusters)
    for cluster in clusters:
        dest = kubeconfig_path(cluster, region, cluster_names)
        destinations.append((profile, region, cluster, dest))
    return destinations, True


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument(
        "profiles",
        nargs="*",
        metavar="PROFILE_GLOB",
        help=f"only scan matching profiles (default: all {PROFILE_PREFIX}* profiles)",
    )
    parser.add_argument(
        "--prune",
        action="store_true",
        help="delete kubeconfigs for clusters that no longer exist "
        "(only when scanning all profiles and every scan succeeded)",
    )
    args = parser.parse_args()

    refresh_profiles()
    profiles = list_profiles(args.profiles)
    if not profiles:
        sys.exit("No matching profiles found")

    K8S_DIR.mkdir(parents=True, exist_ok=True)
    print(f"Scanning {len(profiles)} profiles in {', '.join(EKS_REGIONS)}...")

    written: list[Path] = []
    all_ok = True
    destinations: list[tuple[str, str, str, Path]] = []
    with ThreadPoolExecutor(max_workers=MAX_WORKERS) as executor:
        futures = [
            executor.submit(process, profile, region)
            for profile in profiles
            for region in EKS_REGIONS
        ]
        for future in as_completed(futures):
            clusters, ok = future.result()
            destinations.extend(clusters)
            all_ok &= ok

    collisions: dict[str, list[tuple[str, str, str]]] = {}
    for profile, region, cluster, dest in destinations:
        collisions.setdefault(dest.name, []).append((profile, region, cluster))

    duplicate_destinations = {
        name: clusters
        for name, clusters in collisions.items()
        if len({(profile, region, cluster) for profile, region, cluster in clusters}) > 1
    }
    if duplicate_destinations:
        print("ERROR: Multiple clusters would generate the same kubeconfig name:")
        for name, clusters in sorted(duplicate_destinations.items()):
            print(f"  {name}:")
            for profile, region, cluster in sorted(set(clusters)):
                print(f"    {profile}/{region}/{cluster}")
        sys.exit(1)

    with ThreadPoolExecutor(max_workers=MAX_WORKERS) as executor:
        futures = {
            executor.submit(write_kubeconfig, profile, region, cluster, dest):
            (profile, region, cluster, dest)
            for profile, region, cluster, dest in destinations
        }
        for future in as_completed(futures):
            profile, region, cluster, dest = futures[future]
            err = future.result()
            if err:
                print(f"    WARN [{profile}/{region}/{cluster}]: {err}")
            else:
                print(f"    {profile} / {region} / {cluster} → {dest.name}")
                written.append(dest)

    print(f"Kubeconfigs written: {len(written)} (in {K8S_DIR})")

    if args.prune:
        if args.profiles or not all_ok:
            print("Skipping prune: not every profile was scanned successfully")
        else:
            keep = {p.name for p in written}
            for f in sorted(K8S_DIR.iterdir()):
                if f.is_file() and not f.name.startswith(".") and f.name not in keep:
                    print(f"    pruning {f.name}")
                    f.unlink()

    if not all_ok:
        print("Some profiles failed — is your SSO session valid? (aws sso login)")
        sys.exit(1)


if __name__ == "__main__":
    main()
